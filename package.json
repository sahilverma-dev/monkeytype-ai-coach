{
	"name": "monkey-type-ai-extension",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"zip": "turbo run zip",
		"check-types": "turbo run check-types",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"check": "biome check --write .",
		"format": "biome format --write .",
		"prepare": "lefthook install || true"
	},
	"packageManager": "bun@1.4.0",
	"dependencies": {
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@monkey-type-ai-extension/config": "workspace:*",
		"@types/node": "^26.6.6",
		"lefthook": "^2.2.2",
		"turbo": "^2.11.11",
		"typescript": "^6.0.3",
		"varlock": "1.25.0"
	},
	"license": "MIT"
}
