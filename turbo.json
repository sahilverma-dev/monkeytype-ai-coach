{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".output/**"]
		},
		"zip": {
			"dependsOn": ["build"],
			"outputs": ["dist/**", "*.zip"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"dependsOn": ["build"],
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["*"]
		}
	},
	"globalEnv": ["CI", "NODE_ENV"],
	"globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
