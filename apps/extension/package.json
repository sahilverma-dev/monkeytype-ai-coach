		"@ai-sdk/openai-compatible": "^3.0.93",
		"ai": "^7.0.177",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@wxt-dev/module-react": "^1.2.2",
		"fake-indexeddb": "^6.2.8",
		"jsdom": "^31.0.1",
		"playwright-core": "^1.65.1",
		"typescript": "^6.0.3",
		"vitest": "^5.1.1",
		"wxt": "^0.21.5"
	}
