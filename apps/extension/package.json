{
	"name": "@monkey-type-ai-extension/extension",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wxt -b chrome",
		"build": "wxt build -b chrome",
		"zip": "wxt zip -b chrome",
		"check-types": "wxt prepare && tsc --noEmit",
